# VayuSenseX Environment Configuration Template
# Copy to .env for local testing (Do not commit real keys!)

# Google Gemini API Key (Optional: App functions with deterministic fallback if unset)
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=

# Supabase (Optional: Local-first guest mode is active by default)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Open-Meteo Air Quality & Weather API (Public & Free, no key required)
OPEN_METEO_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
