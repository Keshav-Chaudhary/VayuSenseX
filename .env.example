# ==============================================================================
# VayuSenseX — Server Environment Variables Template
# ==============================================================================
# Copy this file to `.env.local` for local development.
# NEVER commit `.env.local` or actual API keys to version control.
# NEVER prefix secrets with VITE_ (Vite bundles VITE_* vars into client JS).
# ==============================================================================

# Google AI Studio Gemini API Key (Server-side execution only)
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Configurable Gemini model identifier
GEMINI_MODEL=gemini-2.5-flash

# Express 5 Backend Gateway Port
PORT=3001

# Comma-separated CORS allowlist for production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
