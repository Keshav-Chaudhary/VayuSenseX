{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-unused-vars": "error",
    "no-debugger": "error",
    "no-eval": "error"
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "coverage/**"]
}
